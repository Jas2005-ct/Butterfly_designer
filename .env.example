# Copy to .env and fill in values. NEVER commit the real .env (it is git-ignored).

# --- Core Django ---
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# true locally, false (or unset) in production
DJANGO_DEBUG=true
# Comma-separated hosts. Production = your App Runner / custom domain.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated HTTPS origins for CSRF (needed for login POSTs). Production = https://your-domain
CSRF_TRUSTED_ORIGINS=https://127.0.0.1,https://localhost

# --- Database ---
# Local Postgres (docker-compose) — leave unset to fall back to SQLite.
DATABASE_URL=postgres://butterfly_user:butterfly_pass@127.0.0.1:5432/butterfly_db
# Production (Supabase pooled connection string, Mumbai ap-south-1):
# DATABASE_URL=postgresql://<user>:<pass>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Media storage (Supabase S3). Setting AWS_ACCESS_KEY_ID enables S3 media. ---
AWS_STORAGE_BUCKET_NAME=your-bucket
AWS_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
